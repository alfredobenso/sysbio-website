---
import { authorLine, venueLine, typeLabel, ext, type Pub } from '../lib/site';

interface Props { pub: Pub; people: { slug: string; short: string }[] }
const { pub, people } = Astro.props;
const yearLabel = pub.inPress ? 'in press' : String(pub.year ?? '');
const searchText = [pub.title, pub.authors.join(' '), pub.venue, yearLabel].join(' ').toLowerCase();
const link = pub.doi ? `https://doi.org/${pub.doi}` : pub.iris || pub.url;
const linkLabel = pub.doi ? 'DOI' : pub.iris ? 'IRIS record' : 'Link';
---
<li
  class="pub"
  data-year={pub.inPress ? 'press' : pub.year}
  data-type={pub.type}
  data-members={pub.members.join(' ')}
  data-text={searchText}
>
  <div class="side">
    <span class:list={['chip', pub.preprint ? 'bg-yellow' : 'bg-cyan']}>{yearLabel}</span>
    <span class="mono muted">{typeLabel[pub.type]}</span>
  </div>
  <div class="body">
    <h3>{pub.title}</h3>
    <p class="meta">
      {authorLine(pub.authors)}{pub.authors.length && pub.venue ? ' · ' : ''}<em>{venueLine(pub)}</em>
    </p>
    <div class="actions">
      {pub.preprint && <span class="small pre" title="Preprint: not peer-reviewed">{pub.preprint === 'preprint' ? 'preprint' : `preprint · ${pub.preprint}`}</span>}
      {link && <a class="small" href={link} {...ext(link)}>{linkLabel}</a>}
      {pub.iris && pub.doi && <a class="small" href={pub.iris} {...ext(pub.iris)}>IRIS</a>}
      {pub.oa && <span class="small oa">open access</span>}
      {pub.bibtex && (
        <button type="button" class="small copy" data-bibtex={pub.bibtex}>
          Copy BibTeX
        </button>
      )}
      {pub.source === 'orcid' && <span class="mono muted via">via ORCID</span>}
    </div>
  </div>
</li>

<style>
  .pub { display: flex; gap: 20px; padding: 22px 0; border-top: 2px solid var(--ink); list-style: none; }
  .pub[hidden] { display: none; }
  .side { display: flex; flex-direction: column; gap: 8px; min-width: 72px; align-items: flex-start; }
  .body { display: flex; flex-direction: column; gap: 8px; min-width: 0; flex: 1 1 auto; }
  h3 { font: 600 19px/1.3 var(--body); letter-spacing: 0; }
  .meta { color: var(--muted); font-size: 15px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding-top: 2px; }
  .oa { background: var(--lime); cursor: default; }
  .oa:hover { background: var(--lime); color: var(--ink); }
  .pre { background: var(--yellow); cursor: default; }
  .pre:hover { background: var(--yellow); color: var(--ink); }
  .via { padding-left: 4px; }
  @media (max-width: 640px) { .pub { flex-direction: column; gap: 10px; } .side { flex-direction: row; align-items: center; } }
</style>
