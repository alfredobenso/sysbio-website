---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import people from '../data/people.json';
import publications from '../data/publications.json';
import meta from '../data/meta.json';
import { href, ext, type Pub } from '../lib/site';

const recent = (await getCollection('recent')).sort((a, b) => a.data.order - b.data.order);
const recentRendered = await Promise.all(recent.map(async (r) => ({ ...r, Content: (await render(r)).Content })));
const projects = await getCollection('projects');
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const latest = (publications as Pub[]).filter((p) => p.source === 'iris').slice(0, 3);
const shortPeople = people.map((p) => ({ slug: p.slug, short: p.short }));

const areas = [
  { color: 'violet', title: 'Gene regulatory networks', text: 'Boolean and multi-level Petri-net models of how genes, transcription factors and microRNAs regulate each other, and what their attractors say about cell fate.', icon: 'M5 6a2.5 2.5 0 1 0 0 .01M19 6a2.5 2.5 0 1 0 0 .01M12 18a2.5 2.5 0 1 0 0 .01M7 7.5l4 8M17 7.5l-4 8M7.5 6h9' },
  { color: 'cyan', title: 'Biological databases & data integration', text: 'Merging dozens of public -omics sources into one queryable graph. theRING integrates 38 of them into a single vocabulary of regulatory interactions.', icon: 'M4 5c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3' },
  { color: 'coral', title: 'Deep learning for health', text: 'Neural networks for protein function prediction, circulating microRNA signatures, epigenetic markers and language models that read clinical records.', icon: 'M3 12h3l2-6 4 12 3-8 2 2h4' },
  { color: 'yellow', title: 'Biostatistics', text: 'Multivariate statistics and systematic analyses of large public datasets, the way we found the miRNA Pathway Protection Loop motif.', icon: 'M4 20V10M10 20V4M16 20v-8M22 20H2' },
];
---
<Base title="SysBio Group" description="The Systems Biology Group at Politecnico di Torino: computational models, biological databases and AI tools for biologists and clinicians. Open to collaborations." fullFooter>
  <header class="wrap hero">
    <div class="hero-text">
      <span class="chip bg-lime">systems biology · bioinformatics · AI for health</span>
      <h1>Where engineering<br />meets <span class="accent">biology</span>.</h1>
      <p>We are computer engineers at Politecnico di Torino who build the models, databases and AI tools that help biologists and clinicians make sense of their data, from gene regulatory networks to hospital records.</p>
      <div class="cta">
        <a href={href('/people/')} class="btn btn-coral">Meet the team
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href={href('/publications/')} class="btn">Read our papers</a>
      </div>
    </div>

    <figure class="network">
      <div class="tile bg-violet-soft net-box">
        <svg viewBox="0 0 520 400" role="img" aria-label="A regulatory interaction network linking genes, microRNAs, transcription factors, drugs and diseases. Hover a node to enlarge it.">
          <g stroke="#15171C" stroke-width="2.5" stroke-linecap="round" opacity=".85" fill="none">
            <path d="M90 90L210 150M210 150L330 80M210 150L250 260M330 80L430 140M430 140L250 260M250 260L120 310M250 260L400 320M400 320L430 140M120 310L90 90" />
            <path d="M330 80L250 260M90 90L330 80" stroke-dasharray="6 7" />
          </g>
          <circle class="node" cx="90" cy="90" r="26" fill="#5B3DF5" />
          <circle class="node" cx="210" cy="150" r="34" fill="#35C9E8" />
          <circle class="node" cx="330" cy="80" r="22" fill="#FF5E3A" />
          <circle class="node" cx="430" cy="140" r="28" fill="#5B3DF5" />
          <circle class="node" cx="250" cy="260" r="40" fill="#FFD23F" />
          <circle class="node" cx="120" cy="310" r="24" fill="#FF5E3A" />
          <circle class="node" cx="400" cy="320" r="30" fill="#B8F02E" />
          <g class="labels">
            <text x="90" y="135">TP53</text><text x="210" y="201">STAT3</text><text x="330" y="118">miR-21</text>
            <text x="430" y="184">MYC</text><text x="250" y="316">fibrosis</text><text x="120" y="350">miR-155</text><text x="400" y="366">imatinib</text>
          </g>
        </svg>
      </div>
      <figcaption class="legend">
        <span><i class="dot bg-violet"></i> gene / protein</span>
        <span><i class="dot bg-coral"></i> microRNA</span>
        <span><i class="dot bg-cyan"></i> transcription factor</span>
        <span><i class="dot bg-yellow"></i> disease</span>
        <span><i class="dot bg-lime"></i> drug</span>
      </figcaption>
    </figure>
  </header>

  <section class="wrap section" aria-label="Group at a glance">
    <div class="grid-4 stats">
      <a href={href('/publications/')} class="tile lift bg-cyan stat">
        <span class="num">{meta.publications}</span>
        <span class="label">publications</span>
        <span class="mono">live from IRIS · updated nightly</span>
      </a>
      <a href={href('/people/')} class="tile lift bg-coral stat">
        <span class="num">{people.length}</span>
        <span class="label">faculty members</span>
        <span class="mono">profiles synced from polito.it</span>
      </a>
      <a href={href('/projects/')} class="tile lift bg-yellow stat">
        <span class="num">{projects.length}</span>
        <span class="label">funded projects</span>
        <span class="mono">EU · MIUR · regional · ECDC</span>
      </a>
      <a href={href('/projects/#tools')} class="tile lift bg-lime stat">
        <span class="num">{tools.length}</span>
        <span class="label">open tools &amp; databases</span>
        <span class="mono">Cytoscape plugins · theRING</span>
      </a>
    </div>
  </section>

  <section id="recent" class="wrap section" aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h">Recent work</h2>
      <span class="mono">two things we are excited about right now</span>
    </div>
    <div class="grid-2">
      {recentRendered.map((r) => (
        <article class:list={['card lift feature', `bg-${r.data.color}-soft`]}>
          <div class="chips">
            <span class:list={['chip', `bg-${r.data.color}`]}>{r.data.kicker}</span>
            {r.data.badge && <span class="chip">{r.data.badge}</span>}
          </div>
          <h3>{r.data.title}</h3>
          <div class="prose"><r.Content /></div>
          <a href={href(r.data.link)} class="more" {...ext(r.data.link)}>{r.data.linkLabel}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="research" class="wrap section" aria-labelledby="research-h">
    <div class="section-head">
      <h2 id="research-h">What we work on</h2>
      <span class="mono">keywords from our polito.it profiles</span>
    </div>
    <div class="grid-2">
      {areas.map((a) => (
        <article class:list={['card lift area', `top-${a.color}`]}>
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#15171C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.icon} /></svg>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="pubs-h">
    <div class="section-head tight">
      <h2 id="pubs-h">Latest papers</h2>
      <span class="chip bg-cyan">source: Porto@Iris · refreshed nightly</span>
    </div>
    <ul class="publist">
      {latest.map((p) => <Publication pub={p} people={shortPeople} />)}
    </ul>
    <div class="after"><a href={href('/publications/')} class="btn">All {meta.publications} publications, searchable</a></div>
  </section>

  <section class="wrap section" aria-labelledby="tools-h">
    <div class="section-head">
      <h2 id="tools-h">Tools we built, free to use</h2>
      <a href={href('/projects/#tools')} class="seeall">See all {tools.length}</a>
    </div>
    <div class="toolstrip">
      {tools.filter((t) => t.data.featured).map((t, i) => (
        <a href={href(`/projects/#${t.id}`)} class:list={['tile lift tool', { 'bg-lime': i === 0 }]}>
          <span class:list={['chip', i === 0 ? 'bg-paper' : 'bg-lime']}>{t.data.platform}</span>
          <strong>{t.data.title}</strong>
          <span class="desc">{t.data.summary}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding-top: 48px; padding-bottom: 72px; }
  .hero-text { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .hero-text .chip { align-self: flex-start; }
  h1 { font-size: clamp(44px, 6vw, 84px); line-height: 0.98; letter-spacing: -0.035em; }
  .accent { color: var(--violet); }
  .hero-text p { font-size: 20px; max-width: 560px; }
  .cta { display: flex; flex-wrap: wrap; gap: 16px; }

  .network { flex: 1 1 420px; min-width: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .net-box { padding: 20px; }
  .net-box svg { width: 100%; height: auto; display: block; }
  .node { stroke: #15171C; stroke-width: 2.5; transition: transform 0.2s; transform-box: fill-box; transform-origin: center; cursor: pointer; }
  .node:hover { transform: scale(1.35); }
  .labels text { font: 500 13px var(--mono); fill: #15171C; text-anchor: middle; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 13px; }
  .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--ink); vertical-align: -2px; margin-right: 4px; }

  .stat { padding: 24px; text-decoration: none; display: flex; flex-direction: column; gap: 8px; min-width: 0; color: var(--ink); }
  .stat .num { font: 700 56px/1 var(--display); letter-spacing: -0.03em; }
  .stat .label { font-weight: 600; }
  .stat .mono { opacity: 0.8; }

  .feature { padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .feature h3 { font-size: 28px; line-height: 1.15; letter-spacing: -0.02em; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .more { font-weight: 600; align-self: flex-start; }

  .area { padding: 28px; display: flex; flex-direction: column; gap: 14px; border-top-width: 14px; }
  .area h3 { font-size: 24px; line-height: 1.2; }
  .area p { line-height: 1.55; }
  .top-violet { border-top-color: var(--violet); }
  .top-cyan { border-top-color: var(--cyan); }
  .top-coral { border-top-color: var(--coral); }
  .top-yellow { border-top-color: var(--yellow); }

  .tight { margin-bottom: 8px; }
  .publist { margin: 0; padding: 0; border-bottom: 2px solid var(--ink); }
  .after { margin-top: 28px; }
  .seeall { font-weight: 600; }

  .toolstrip { display: flex; gap: 24px; overflow-x: auto; padding: 4px 4px 14px; scroll-snap-type: x proximity; }
  .tool { flex: 0 0 260px; padding: 20px; text-decoration: none; display: flex; flex-direction: column; gap: 10px; color: var(--ink); scroll-snap-align: start; }
  .tool .chip { align-self: flex-start; }
  .tool strong { font: 700 24px/1.1 var(--display); }
  .tool .desc { font-size: 15px; line-height: 1.45; }
  @media (max-width: 640px) {
    .hero { padding-top: 24px; padding-bottom: 48px; gap: 32px; }
    .hero-text p { font-size: 17px; }
    .feature { padding: 24px; }
    .feature h3 { font-size: 24px; }
  }
</style>
